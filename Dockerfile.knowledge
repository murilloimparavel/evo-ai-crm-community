# Preserve the verified production runtime/dependencies. The source checkout must
# contain production 310ec304 plus the urgent ordering correction.
FROM ghcr.io/murilloimparavel/crcn-knowledge-crm@sha256:4ead1ff1179e01fbcc0698147ed8b758fc2caf3c94edd5fa5df548702e099c0c

# Copy the complete application namespaces so new models, services, jobs, routes,
# cron definitions and migrations cannot be omitted by an outdated file list.
# Secrets stay in runtime environment; .dockerignore excludes .env files.
COPY app/ /app/app/
COPY config/ /app/config/
COPY lib/ /app/lib/
COPY db/ /app/db/

ARG GIT_SHA
RUN test -n "$GIT_SHA" && printf '%s\n' "$GIT_SHA" > /app/.git_sha
